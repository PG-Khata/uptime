# ==========================================
# UPTIME MONITOR - ENVIRONMENT CONFIGURATION
# ==========================================

PORT=3000

# Resend Email API (Recommended - Free 3,000 emails/mo)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PGKhata <no-reply@pgkhata.com>

# Email Alerts (SMTP / Gmail App Password - Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Uptime Monitor <your-email@gmail.com>"

# Webhook Alert (Optional: Discord / Slack)
WEBHOOK_URL=
